{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/content/presets/astral.cyclegraph"
    },
    {
      "command": "pointer",
      "targetId": "PerformanceKeyboard.Note60",
      "event": "down",
      "targetY": 0.85
    },
    {
      "command": "captureLiveAudio",
      "durationMs": 500,
      "path": "/private/tmp/cycle-v2-astral-live-publication.wav",
      "peakGreaterThan": 0.00001,
      "rmsGreaterThan": 0.000001,
      "peakLessThan": 1.0
    },
    {
      "command": "assertState",
      "path": "performance.executionStepCount",
      "equals": 17
    },
    {
      "command": "assertState",
      "path": "performance.oscillatorRegionCount",
      "equals": 1
    },
    {
      "command": "assertState",
      "path": "performance.heldNote",
      "equals": 60
    },
    {
      "command": "pointer",
      "targetId": "PerformanceKeyboard.Note60",
      "event": "up",
      "targetY": 0.85
    }
  ],
  "quit": true
}
