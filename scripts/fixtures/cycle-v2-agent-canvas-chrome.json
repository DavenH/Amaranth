{
  "commands": [
    {
      "command": "waitForIdle",
      "idleDelayMs": 1200
    },
    {
      "command": "assertState",
      "path": "guideDock.expanded",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "performance.visible",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "performance.docked",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "performance.screenWidth",
      "op": "greaterThan",
      "value": 500
    },
    {
      "command": "assertState",
      "path": "performance.screenHeight",
      "op": "greaterThan",
      "value": 100
    },
    {
      "command": "inspectTargets",
      "area": "canvas"
    }
  ],
  "quit": false
}
