{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/content/presets/old/accoustic.cyclegraph"
    },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "node:fft",
      "targetX": 0.5,
      "targetY": 0.5
    },
    {
      "command": "pointer",
      "area": "canvas",
      "event": "down",
      "x": 320,
      "y": 260,
      "shift": true
    },
    {
      "command": "pointer",
      "area": "canvas",
      "event": "drag",
      "x": 680,
      "y": 430,
      "shift": true
    },
    {
      "command": "pointer",
      "area": "canvas",
      "event": "up",
      "x": 680,
      "y": 430,
      "shift": true
    },
    {
      "command": "assertState",
      "path": "selectedNodeCount",
      "equals": 3
    },
    {
      "command": "key",
      "area": "canvas",
      "key": "commandG"
    },
    {
      "command": "assertState",
      "path": "nodeGroupCount",
      "equals": 1
    },
    {
      "command": "assertState",
      "path": "documentDirty",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "nodeGroups.0.memberCount",
      "equals": 3
    },
    {
      "command": "pointer",
      "event": "doubleClick",
      "targetId": "groupToggle:0",
      "targetX": -1.0,
      "targetY": 0.5,
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "key",
      "area": "focused",
      "key": "escape"
    },
    {
      "command": "assertState",
      "path": "nodeGroups.0.title",
      "equals": "Group"
    },
    {
      "command": "pointer",
      "event": "doubleClick",
      "targetId": "groupToggle:0",
      "targetX": -1.0,
      "targetY": 0.5
    },
    {
      "command": "key",
      "area": "focused",
      "key": "return"
    },
    {
      "command": "assertState",
      "path": "nodeGroups.0.title",
      "equals": "Group"
    }
  ],
  "quit": true
}
