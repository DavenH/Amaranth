{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/content/presets/stengah.cyclegraph"
    },
    {
      "command": "assertState",
      "path": "compileSucceeded",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "probePreviewStats.0.connected",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "probePreviewStats.1.connected",
      "equals": true
    },
    {
      "command": "openNodeEditor",
      "nodeId": "waveshaper"
    },
    {
      "command": "setNodeParameter",
      "nodeId": "waveshaper",
      "parameterId": "pre",
      "label": "Pre",
      "value": "0.5",
      "waitForIdle": true,
      "idleDelayMs": 300
    },
    {
      "command": "assertState",
      "path": "probePreviewStats.0.connected",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "probePreviewStats.1.connected",
      "equals": true
    },
    {
      "command": "screenshot",
      "area": "canvas",
      "path": "/private/tmp/cycle-v2-stengah-probes.png"
    }
  ]
}
