{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/content/presets/baroque-flute.cyclegraph",
      "waitForIdle": true,
      "idleDelayMs": 300
    },
    {
      "command": "openNodeEditor",
      "nodeId": "timeLayer1",
      "waitForIdle": true,
      "idleDelayMs": 350
    },
    { "command": "assertState", "path": "comparison.visible", "equals": false },
    { "command": "assertState", "path": "comparison.captureCount", "equals": 0 },
    { "command": "invokeMenuItem", "id": "view.comparisonShelf" },
    { "command": "assertState", "path": "comparison.visible", "equals": true },
    { "command": "assertState", "path": "comparison.cardCount", "equals": 0 },
    { "command": "assertState", "path": "comparison.selectedReferenceId", "equals": "" },
    { "command": "selectReference", "referenceId": "factory:sine500" },
    { "command": "assertState", "path": "comparison.cardCount", "equals": 1 },
    { "command": "assertState", "path": "comparison.selectedReferenceId", "equals": "factory:sine500" },
    { "command": "invokeMenuItem", "id": "view.comparisonShelf" },
    { "command": "assertState", "path": "comparison.visible", "equals": false },
    { "command": "invokeMenuItem", "id": "view.comparisonShelf" },
    { "command": "assertState", "path": "comparison.visible", "equals": true }
  ],
  "quit": true
}
