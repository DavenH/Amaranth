    { "command": "pointer", "event": "up", "targetId": "voiceContextEditor.octave", "downTargetId": "voiceContextEditor.octave", "targetX": 0.9, "targetY": 0.5, "downTargetX": 0.1, "downTargetY": 0.5 },
    { "command": "assertState", "path": "nodes.0.parameters.1.value", "equals": "2" },
