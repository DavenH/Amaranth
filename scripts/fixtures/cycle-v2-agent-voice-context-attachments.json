    { "command": "pointer", "event": "up", "targetId": "voiceContextEditor.pitch", "downTargetId": "voiceContextEditor.pitch", "targetX": 0.72, "targetY": 0.5, "downTargetX": 0.1, "downTargetY": 0.5 },
    { "command": "assertState", "path": "nodes.0.parameters.2.value", "equals": "6.000000" },
    { "command": "pointer", "event": "down", "targetId": "voiceContextEditor.oversampling.8x", "targetX": 0.5, "targetY": 0.5 },
    { "command": "pointer", "event": "up", "targetId": "voiceContextEditor.oversampling.8x", "downTargetId": "voiceContextEditor.oversampling.8x", "targetX": 0.5, "targetY": 0.5, "downTargetX": 0.5, "downTargetY": 0.5 },
    { "command": "assertState", "path": "nodes.0.parameters.4.value", "equals": "8x" },
    { "command": "pointer", "event": "down", "targetId": "voiceContextEditor.voiceLength", "targetX": 0.2, "targetY": 0.5 },
    { "command": "pointer", "event": "drag", "targetId": "voiceContextEditor.voiceLength", "downTargetId": "voiceContextEditor.voiceLength", "targetX": 0.9, "targetY": 0.5, "downTargetX": 0.2, "downTargetY": 0.5 },
    { "command": "pointer", "event": "up", "targetId": "voiceContextEditor.voiceLength", "downTargetId": "voiceContextEditor.voiceLength", "targetX": 0.9, "targetY": 0.5, "downTargetX": 0.2, "downTargetY": 0.5, "waitForIdle": true, "idleDelayMs": 150 },
    { "command": "assertState", "path": "previewVoiceLengthSeconds", "op": "greaterThan", "value": 3.0 },
    { "command": "screenshot", "area": "window", "path": "/private/tmp/cycle-v2-voice-context-attachments.png" }
