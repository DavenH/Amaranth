      "event": "down",
      "targetX": 0.3
    },
    {
      "command": "pointer",
      "targetId": "PerformanceKeyboard.Header",
      "downTargetId": "PerformanceKeyboard.Header",
      "event": "drag",
      "targetX": 0.7,
      "downTargetX": 0.3
    },
    {
      "command": "pointer",
      "targetId": "PerformanceKeyboard.Header",
      "downTargetId": "PerformanceKeyboard.Header",
      "event": "drag",
      "targetX": 0.9,
      "targetY": 0.8,
      "downTargetX": 0.3,
      "downTargetY": 0.5
    },
    {
      "command": "pointer",
      "targetId": "PerformanceKeyboard.Header",
      "downTargetId": "PerformanceKeyboard.Header",
      "event": "up",
      "targetX": 0.7,
      "downTargetX": 0.3
    },
    {
      "command": "assertState",
      "path": "performance.moveCount",
      "op": "greaterThan",
      "value": 1
    },
    {
      "command": "assertState",
      "path": "performance.presetPositionStored",
      "equals": true
    },
    {
      "command": "saveGraph",
      "path": "/private/tmp/cycle-v2-performance-keyboard-position.cyclegraph"
    },
    {
      "command": "pointer",
      "targetId": "PerformanceKeyboard.Note60",
      "event": "down",
      "targetY": 0.85
    },
    {
      "command": "captureLiveAudio",
      "durationMs": 500,
      "path": "/private/tmp/cycle-v2-performance-keyboard-live.wav",
      "peakGreaterThan": 0.00001,
      "rmsGreaterThan": 0.000001,
      "peakLessThan": 1.0
    },
    {
      "command": "assertState",
      "path": "performance.heldNote",
      "equals": 60
    },
    {
      "command": "assertState",
      "path": "performance.activeVoiceCount",
      "op": "greaterThan",
      "value": 0
    },
    {
      "command": "assertState",
      "path": "performance.peak",
      "op": "greaterThan",
      "value": 0.00001
    },
    {
      "command": "assertState",
      "path": "performance.rms",
      "op": "greaterThan",
      "value": 0.000001
    },
    {
      "command": "screenshot",
      "area": "workspace",
      "path": "/private/tmp/cycle-v2-performance-keyboard.png"
    },
    {
      "command": "pointer",
      "targetId": "PerformanceKeyboard.Note62",
      "downTargetId": "PerformanceKeyboard.Note60",
      "event": "drag",
      "targetY": 0.85,
      "downTargetY": 0.85
    },
    {
      "command": "assertState",
      "path": "performance.heldNote",
      "equals": 62
    },
    {
      "command": "pointer",
      "targetId": "PerformanceKeyboard.Note62",
      "downTargetId": "PerformanceKeyboard.Note60",
      "event": "up",
      "targetY": 0.85,
      "downTargetY": 0.85
    },
    {
      "command": "assertState",
      "path": "performance.heldNote",
      "equals": -1
    },
    {
      "command": "waitForIdle",
      "delayMs": 8000
    },
    {
      "command": "assertState",
      "path": "performance.activeVoiceCount",
      "equals": 0
