{
  "commands": [
    {
      "command": "assertState",
      "path": "performance.visible",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "performance.hostedByCanvas",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "performance.worldWidth",
      "equals": 496
    },
    {
      "command": "assertState",
      "path": "performance.baseNote",
      "equals": 60
    },
    {
      "command": "assertState",
      "path": "performance.highestNote",
      "equals": 72
    },
    {
      "command": "assertState",
      "path": "performance.baseNoteLabel",
      "equals": "C3"
    },
    {
      "command": "assertState",
      "path": "performance.highestNoteLabel",
      "equals": "C4"
    },
    {
      "command": "assertState",
      "path": "performance.audioDeviceReady",
      "equals": true
    },
    {
      "command": "pointer",
