    { "command": "pointer", "targetId": "PerformanceKeyboard.PlaySequence", "event": "click" },
    { "command": "waitForIdle", "idleDelayMs": 100 },
    { "command": "assertState", "path": "performance.previewPlaying", "equals": false },
    { "command": "pointer", "targetId": "PerformanceKeyboard.RecordSequence", "event": "click" },
    { "command": "waitForIdle", "idleDelayMs": 100 },
    { "command": "assertState", "path": "performance.previewRecording", "equals": true },
    { "command": "pointer", "targetId": "PerformanceKeyboard.Note60", "event": "down" },
