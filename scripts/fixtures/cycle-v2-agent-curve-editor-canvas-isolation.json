{
  "commands": [
    {
      "command": "openNodeEditor",
      "nodeId": "env",
      "waitForIdle": true,
      "idleDelayMs": 300
    },
    {
      "command": "invokeMenuItem",
      "id": "file.spyRefreshLive"
    },
    {
      "command": "requestCanvasOpenGLFrame"
    },
    {
      "command": "waitForIdle",
      "delayMs": 250
    },
    {
      "command": "resetCanvasPerformance"
    },
    {
      "command": "pointer",
      "event": "down",
      "targetId": "expanded:env.panel2D",
      "targetX": 0.035,
      "targetY": 0.02
    },
    {
      "command": "pointer",
      "event": "drag",
      "targetId": "expanded:env.panel2D",
      "downTargetId": "expanded:env.panel2D",
      "targetX": 0.15,
      "targetY": 0.2,
      "downTargetX": 0.035,
      "downTargetY": 0.02
    },
    {
      "command": "waitForIdle",
      "delayMs": 150
    },
    {
      "command": "inspectCanvasPerformance",
      "maxRepaintRequests": 0,
      "maxPreviewRequests": 0
    },
    {
      "command": "pointer",
      "event": "up",
      "targetId": "expanded:env.panel2D",
      "downTargetId": "expanded:env.panel2D",
      "targetX": 0.15,
      "targetY": 0.2,
      "downTargetX": 0.035,
      "downTargetY": 0.02,
      "waitForIdle": true,
      "idleDelayMs": 300
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.model.revision",
      "equals": 2
    },
    {
      "command": "inspectCanvasPerformance"
    }
  ],
  "quit": true
}
