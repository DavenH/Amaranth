      "downTargetY": 0.5
    },
    {
      "command": "pointer",
      "event": "up",
      "targetId": "node:voice",
      "downTargetId": "node:voice",
      "targetX": 0.8,
      "targetY": 0.5,
      "downTargetX": 0.5,
      "downTargetY": 0.5,
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "assertState",
      "path": "nodes.0.bounds.x",
      "op": "greaterThan",
      "value": 475.2
    },
    {
      "command": "assertState",
      "path": "probes.0.canvasX",
      "op": "greaterThan",
      "value": 0
    },
    {
      "command": "undo",
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "assertState",
      "path": "nodes.0.bounds.x",
      "op": "lessThan",
      "value": 475.201
    }
  ],
  "quit": true
