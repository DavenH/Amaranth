{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/content/presets/african-horn.cyclegraph"
    },
    {
      "command": "openMeshPopup",
      "nodeId": "timeLayer2"
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.trimesh.panelGuideRailSegmentCount",
      "op": "greaterThan",
      "value": 0
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.trimesh.panelAbsoluteSum",
      "op": "greaterThan",
      "value": 1.0
    },
    {
      "command": "screenshot",
      "area": "window",
      "path": "/private/tmp/cycle-v2-african-horn-guide-tags.png"
    },
    {
      "command": "waitForIdle",
      "idleDelayMs": 700
    }
  ],
  "quit": true
}
