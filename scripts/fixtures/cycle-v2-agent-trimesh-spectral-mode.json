{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/content/presets/accoustic.cyclegraph"
    },
    {
      "command": "openMeshPopup",
      "nodeId": "magnitudeLayer1"
    },
    {
      "command": "waitForIdle",
      "idleDelayMs": 300
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.spectralModeVisible",
      "equals": true
    },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "trimeshEditor.spectralMode.multiplicative",
      "targetX": 0.5,
      "targetY": 0.5,
      "waitForIdle": true,
      "idleDelayMs": 250
    },
    {
      "command": "assertNodeParameter",
      "nodeId": "magnitudeLayer1",
      "parameterId": "spectralMode",
      "equals": "multiplicative"
    },
    {
      "command": "inspectTargets",
      "area": "canvas"
    }
  ],
  "quit": false
}
