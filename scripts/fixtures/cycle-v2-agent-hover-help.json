{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/content/presets/stengah.cyclegraph"
    },
    { "command": "resetCanvasPerformance" },
    {
      "command": "pointer",
      "event": "move",
      "targetId": "node:magnitudeLayer1",
      "targetX": 0.5,
      "targetY": 0.5
    },
    {
      "command": "assertState",
      "path": "hoverRepaintRequestCount",
      "equals": 1
    },
    {
      "command": "pointer",
      "event": "move",
      "targetId": "node:magnitudeLayer1",
      "targetX": 0.55,
      "targetY": 0.5
    },
    {
      "command": "assertState",
      "path": "hoverRepaintRequestCount",
      "equals": 1
    },
    {
      "command": "pointer",
      "event": "move",
      "targetId": "node:magnitudeLayer1Process",
      "targetX": 0.5,
      "targetY": 0.5
    },
    {
      "command": "assertState",
      "path": "hoverRepaintRequestCount",
      "equals": 2
    },
    {
      "command": "screenshot",
      "area": "canvas",
      "path": "/private/tmp/cycle-v2-hover-help.png"
    }
  ],
  "quit": true
}
