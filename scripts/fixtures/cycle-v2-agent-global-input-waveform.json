    {"command": "assertState", "path": "probeWaveform.waveform.ready", "equals": true},
    {"command": "assertState", "path": "probeWaveform.waveform.sourceBuilds", "equals": 1},
    {"command": "assertState", "path": "probeWaveform.waveform.heatBuilds", "equals": 1},
    {"command": "screenshot", "area": "canvas", "path": "../../.context/global-input-waveform-detail.png"},
    {"command": "key", "key": "escape"},
    {"command": "pinComparisonSpy", "probeId": "probe"},
    {"command": "waitForIdle", "idleDelayMs": 800},
    {"command": "assertState", "path": "comparison.cards.0.surfaceView.waveform.ready", "equals": true},
    {"command": "snapshotState"}
  ],
  "quit": true
}
