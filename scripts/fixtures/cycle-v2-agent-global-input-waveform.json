    {"command": "setSpyView", "probeId": "probe", "view": "time"},
    {"command": "waitForIdle", "idleDelayMs": 800},
    {"command": "assertState", "path": "probes.0.view", "equals": "time"},
    {"command": "assertState", "path": "probePreviewStats.0.waveformSamples", "equals": 0},
    {"command": "setSpyView", "probeId": "probe", "view": "waveform"},
    {"command": "waitForIdle", "idleDelayMs": 800},
    {"command": "assertState", "path": "probes.0.view", "equals": "waveform"},
    {"command": "assertState", "path": "probePreviewStats.0.waveformSamples", "op": "greaterThan", "value": 40000},
    {"command": "setSpyView", "probeId": "probe", "view": "spectrum"},
    {"command": "waitForIdle", "idleDelayMs": 800},
    {"command": "assertState", "path": "probes.0.view", "equals": "spectrum"},
    {"command": "assertState", "path": "probePreviewStats.0.waveformSamples", "equals": 0},
    {"command": "setSpyView", "probeId": "probe", "view": "waveform"},
    {"command": "waitForIdle", "idleDelayMs": 800},
    {"command": "assertState", "path": "probes.0.view", "equals": "waveform"},
    {"command": "assertState", "path": "probePreviewStats.0.waveformSamples", "op": "greaterThan", "value": 40000},
    {"command": "screenshot", "area": "canvas", "path": "../../.context/global-input-waveform-compact.png"},
