{
  "commands": [
    { "command": "openGraph", "path": "../../cycle-v2/content/presets/old/accoustic.cyclegraph" },
    { "command": "pointer", "event": "click", "targetId": "node:fft", "targetX": 0.5, "targetY": 0.5 },
    { "command": "assertState", "path": "selectedNodeIds.0", "equals": "fft" },
    { "command": "pointer", "area": "canvas", "event": "down", "x": 110, "y": 170, "shift": true },
    { "command": "pointer", "area": "canvas", "event": "drag", "x": 370, "y": 260, "shift": true },
    { "command": "screenshot", "area": "canvas", "path": "/private/tmp/cycle-v2-node-area-selection-live.png" },
    { "command": "pointer", "area": "canvas", "event": "up", "x": 370, "y": 260, "shift": true },
    { "command": "assertState", "path": "selectedNodeCount", "equals": 3 },
    { "command": "assertState", "path": "selectedNodeIds.0", "equals": "fft" },
    { "command": "assertState", "path": "selectedNodeIds.1", "equals": "voice" },
    { "command": "assertState", "path": "selectedNodeIds.2", "equals": "morph" },
    { "command": "assertState", "path": "selectedNodeId", "equals": "fft" },
    { "command": "assertState", "path": "documentDirty", "equals": false },
    { "command": "screenshot", "area": "canvas", "path": "/private/tmp/cycle-v2-node-area-selection-selected.png" }
  ],
  "quit": true
}
