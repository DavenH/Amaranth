{
  "commands": [
    { "command": "openNodeEditor", "nodeId": "env", "waitForIdle": true, "idleDelayMs": 200 },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.blueMorph",
      "equals": 0
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.panelState.colorPointCount",
      "op": "greaterThan",
      "value": 0
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.panelState.visibleColorPointCount",
      "equals": 0
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.panelState.visibleColorLineCount",
      "op": "greaterThan",
      "value": 0
    },
    {
      "command": "screenshot",
      "area": "window",
      "path": "/private/tmp/cycle-v2-envelope-no-depth-points.png"
    }
  ],
  "quit": true
}
