      "area": "canvas",
      "path": "/private/tmp/cycle-v2-pan-drag-arc.png"
    },
    {
      "command": "pointer",
      "event": "up",
      "targetId": "node:magnitudeLayer1Process",
      "downTargetId": "node:magnitudeLayer1Process",
      "targetX": 0.5,
      "targetY": 0.6,
      "downTargetX": 0.5,
      "downTargetY": 0.5,
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "screenshot",
      "area": "canvas",
      "path": "/private/tmp/cycle-v2-pan-resting.png"
    }
  ],
  "quit": true
}
