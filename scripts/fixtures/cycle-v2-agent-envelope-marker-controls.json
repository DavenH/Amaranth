{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/resources/default.cyclegraph"
    },
    {
      "command": "openNodeEditor",
      "nodeId": "env",
      "waitForIdle": true,
      "idleDelayMs": 200
    },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "expanded:env.meshDimensions.three"
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.loopEnabled",
      "equals": false
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.sustainEnabled",
      "equals": false
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.loopTooltip",
      "equals": "Select one envelope vertex to set the loop start"
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.axisScaleGroupLabel",
      "equals": "Scaling"
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.rangeGroupLabel",
      "equals": "Zoom"
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.actionIconsVector",
      "equals": true
    },
    {
      "command": "inspectPointerTargets"
    },
    {
      "command": "pointer",
      "event": "move",
      "targetId": "expanded:env.envelopeAction.loop"
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.loopEnabled",
      "equals": false
    },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "expanded:env.panel2D",
      "targetX": 0.02,
      "targetY": 0.9,
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.loopEnabled",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.sustainEnabled",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.guideControlsVisible",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.axisGroupLabelBounds.width",
      "equals": 24
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.loopTooltip",
      "equals": "Toggle selected vertex as loop start"
    },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "expanded:env.envelopeAction.loop",
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.loopSelected",
      "equals": true
    },
    {
      "command": "undo",
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.loopSelected",
      "equals": false
    },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "expanded:env.panel2D",
      "targetX": 0.02,
      "targetY": 0.9,
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "expanded:env.envelopeAction.sustain",
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.sustainSelected",
      "equals": true
    },
    {
      "command": "undo",
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "assertState",
      "path": "expandedNodeControls.effect2D.sustainSelected",
      "equals": false
    },
    {
      "command": "screenshot",
      "area": "canvas",
      "path": "../../.context/marker-overlay-fixture.png"
    }
  ],
  "quit": true
}
