{
  "commands": [
    {
      "command": "openFactoryPreset",
      "preset": "ooh-aah",
      "waitForIdle": true,
      "idleDelayMs": 300
    },
    {
      "command": "action",
      "actionType": "Disable",
      "area": "AreaDelay"
    },
    {
      "command": "action",
      "actionType": "Disable",
      "area": "AreaUnison"
    },
    {
      "command": "setControl",
      "area": "AreaMasterCtrls",
      "target": "TargMasterVol",
      "value": 0.005
    },
    {
      "command": "pointer",
      "area": "AreaMain",
      "target": "TargMidiKeyboard",
      "event": "down",
      "normalizedX": 0.35,
      "normalizedY": 0.85
    },
    {
      "command": "captureLiveAudio",
      "durationMs": 200,
      "path": "/private/tmp/cycle-agent-keyboard-first-note.wav",
      "peakGreaterThan": 0.0001,
      "rmsGreaterThan": 0.00001
    },
    {
      "command": "pointer",
      "area": "AreaMain",
      "target": "TargMidiKeyboard",
      "event": "up",
      "normalizedX": 0.35,
      "normalizedY": 0.85,
      "normalizedDownX": 0.35,
      "normalizedDownY": 0.85
    },
    {
      "command": "captureLiveAudio",
      "durationMs": 60,
      "path": "/private/tmp/cycle-agent-keyboard-release.wav",
      "peakGreaterThan": 0.000001
    },
    {
      "command": "pointer",
      "area": "AreaMain",
      "target": "TargMidiKeyboard",
      "event": "down",
      "normalizedX": 0.65,
      "normalizedY": 0.85
    },
    {
      "command": "captureLiveAudio",
      "durationMs": 250,
      "path": "/private/tmp/cycle-agent-keyboard-second-note.wav",
      "peakGreaterThan": 0.0001,
      "rmsGreaterThan": 0.00001
    },
    {
      "command": "pointer",
      "area": "AreaMain",
      "target": "TargMidiKeyboard",
      "event": "up",
      "normalizedX": 0.65,
      "normalizedY": 0.85,
      "normalizedDownX": 0.65,
      "normalizedDownY": 0.85
    }
  ],
  "quit": true
}
