{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/content/presets/accoustic.cyclegraph"
    },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "node:voice",
      "targetX": 0.5,
      "targetY": 0.5
    },
    { "command": "assertState", "path": "selectedNodeCount", "equals": 1 },
    { "command": "assertState", "path": "selectedNodeIds.0", "equals": "voice" },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "node:morph",
      "targetX": 0.5,
      "targetY": 0.5,
      "shift": true
    },
    { "command": "assertState", "path": "selectedNodeCount", "equals": 2 },
    { "command": "assertState", "path": "selectedNodeIds.0", "equals": "voice" },
    { "command": "assertState", "path": "selectedNodeIds.1", "equals": "morph" },
    {
      "command": "pointer",
      "event": "down",
      "targetId": "node:morph",
      "targetX": 0.5,
      "targetY": 0.5
    },
    {
      "command": "pointer",
      "event": "drag",
      "targetId": "node:morph",
      "downTargetId": "node:morph",
      "targetX": 0.75,
      "targetY": 0.5,
      "downTargetX": 0.5,
      "downTargetY": 0.5
    },
    {
      "command": "pointer",
      "event": "up",
      "targetId": "node:morph",
      "downTargetId": "node:morph",
      "targetX": 0.75,
      "targetY": 0.5,
      "downTargetX": 0.5,
      "downTargetY": 0.5,
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    { "command": "assertState", "path": "selectedNodeCount", "equals": 2 },
    { "command": "assertState", "path": "nodes.0.bounds.x", "op": "greaterThan", "value": 161.65 },
    { "command": "assertState", "path": "nodes.1.bounds.x", "op": "greaterThan", "value": -209.39 },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "node:voice",
      "targetX": 0.5,
      "targetY": 0.5,
      "shift": true
    },
    { "command": "assertState", "path": "selectedNodeCount", "equals": 1 },
    { "command": "assertState", "path": "selectedNodeIds.0", "equals": "morph" }
  ],
  "quit": true
}
