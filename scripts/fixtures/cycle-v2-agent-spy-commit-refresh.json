{
  "commands": [
    {"command": "openGraph", "path": "../../cycle-v2/content/presets/old/baroque-flute.cyclegraph"},
    {"command": "invokeMenuItem", "id": "file.spyRefreshLive"},
    {"command": "assertState", "path": "probeRefreshMode", "equals": "Live"},
    {"command": "waitForIdle", "idleDelayMs": 300},
    {"command": "resizeWindow", "width": 1000, "height": 700},
    {"command": "selectReference", "referenceId": "factory:sax-growl"},
    {"command": "assertState", "path": "comparison.comparisonMidiNote", "equals": 45},
    {"command": "pinComparisonSpy", "probeId": "default-output"},
    {"command": "openNodeEditor", "nodeId": "timeLayer1"},
    {"command": "waitForIdle", "idleDelayMs": 350},
    {"command": "assertState", "path": "comparison.visible", "equals": true},
    {"command": "assertState", "path": "comparison.cardCount", "op": "greaterThan", "value": 1},
    {"command": "assertState", "path": "comparison.captureCount", "equals": 1},
    {"command": "pointer", "event": "down", "targetId": "expanded:timeLayer1.trimeshOutputScale.gain", "targetX": 0.4, "targetY": 0.5},
    {"command": "pointer", "event": "drag", "targetId": "expanded:timeLayer1.trimeshOutputScale.gain", "downTargetId": "expanded:timeLayer1.trimeshOutputScale.gain", "targetX": 0.75, "targetY": 0.5, "downTargetX": 0.4, "downTargetY": 0.5},
    {"command": "waitForIdle", "idleDelayMs": 800},
    {"command": "assertState", "path": "comparison.captureCount", "equals": 1},
    {"command": "pointer", "event": "up", "targetId": "expanded:timeLayer1.trimeshOutputScale.gain", "downTargetId": "expanded:timeLayer1.trimeshOutputScale.gain", "targetX": 0.75, "targetY": 0.5, "downTargetX": 0.4, "downTargetY": 0.5},
    {"command": "waitForIdle", "idleDelayMs": 2500},
    {"command": "assertState", "path": "comparison.captureCount", "equals": 2},
    {"command": "assertState", "path": "comparison.cards.0.hasSurface", "equals": true},
    {"command": "assertState", "path": "comparison.cards.1.hasSurface", "equals": true},
    {"command": "assertState", "path": "comparison.cards.0.midiNote", "equals": 45},
    {"command": "assertState", "path": "comparison.cards.1.midiNote", "equals": 45},
    {"command": "assertState", "path": "comparison.cards.0.surfaceView.contextCreateCount", "op": "greaterThan", "value": 0},
    {"command": "inspectPointerTargets"},
    {"command": "invokeMenuItem", "id": "file.spyRefreshOnRelease"},
    {"command": "assertState", "path": "probeRefreshMode", "equals": "On Release"},
    {"command": "pointer", "event": "down", "targetId": "expanded:timeLayer1.trimeshOutputScale.gain", "targetX": 0.75, "targetY": 0.5},
    {"command": "pointer", "event": "drag", "targetId": "expanded:timeLayer1.trimeshOutputScale.gain", "targetX": 0.4, "targetY": 0.5, "downTargetId": "expanded:timeLayer1.trimeshOutputScale.gain", "downTargetX": 0.75, "downTargetY": 0.5},
    {"command": "waitForIdle", "idleDelayMs": 800},
    {"command": "assertState", "path": "comparison.captureCount", "equals": 2},
    {"command": "pointer", "event": "up", "targetId": "expanded:timeLayer1.trimeshOutputScale.gain", "targetX": 0.4, "targetY": 0.5, "downTargetId": "expanded:timeLayer1.trimeshOutputScale.gain", "downTargetX": 0.75, "downTargetY": 0.5},
    {"command": "waitForIdle", "idleDelayMs": 2500},
    {"command": "assertState", "path": "comparison.captureCount", "equals": 3},
    {"command": "invokeMenuItem", "id": "file.spyRefreshLive"}
  ],
  "quit": true
}
