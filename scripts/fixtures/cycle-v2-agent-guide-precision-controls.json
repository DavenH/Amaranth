{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/content/presets/baroque-flute.cyclegraph"
    },
    {
      "command": "waitForIdle",
      "idleDelayMs": 500
    },
    {
      "command": "pointer",
      "event": "doubleClick",
      "targetId": "guide:guide1",
      "waitForIdle": true,
      "idleDelayMs": 200
    },
    {
      "command": "assertState",
      "path": "guideDock.editor.noiseLayout.usableTrackWidth",
