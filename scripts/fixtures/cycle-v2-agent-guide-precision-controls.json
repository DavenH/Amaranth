    },
    {
      "command": "inspectPointerTargets"
    },
    {
      "command": "pointer",
      "event": "down",
      "targetId": "guideEditor.noise",
      "targetX": 0.76
    },
    {
      "command": "pointer",
      "event": "drag",
      "targetId": "guideEditor.noise",
      "downTargetId": "guideEditor.noise",
      "targetX": 0.2,
      "downTargetX": 0.76
    },
    {
      "command": "pointer",
      "event": "up",
      "targetId": "guideEditor.noise",
      "downTargetId": "guideEditor.noise",
      "targetX": 0.2,
      "downTargetX": 0.76,
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "assertState",
      "path": "guides.0.noise",
      "op": "lessThan",
      "value": 0.3
    },
    {
      "command": "pointer",
      "event": "down",
      "targetId": "guideEditor.noise",
      "targetX": 0.2,
      "shift": true
    },
    {
      "command": "pointer",
      "event": "drag",
      "targetId": "guideEditor.noise",
      "downTargetId": "guideEditor.noise",
      "targetX": 0.4,
      "downTargetX": 0.2,
      "shift": true
    },
    {
      "command": "pointer",
      "event": "up",
      "targetId": "guideEditor.noise",
      "downTargetId": "guideEditor.noise",
      "targetX": 0.4,
      "downTargetX": 0.2,
      "shift": true,
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "assertState",
      "path": "guides.0.noise",
      "op": "greaterThan",
      "value": 0.142
    },
    {
      "command": "assertState",
      "path": "guides.0.noise",
      "op": "lessThan",
      "value": 0.16
    },
    {
      "command": "pointer",
      "event": "doubleClick",
      "targetId": "guideEditor.noise",
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "assertState",
      "path": "guides.0.noise",
      "equals": 0
    },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "guideEditor.close",
      "waitForIdle": true,
      "idleDelayMs": 150
    },
    {
      "command": "assertState",
      "path": "expandedGuideId",
      "equals": ""
    }
  ],
  "quit": true
}
