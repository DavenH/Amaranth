{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/content/presets/baroque-flute.cyclegraph",
      "waitForIdle": true,
      "idleDelayMs": 300
    },
    { "command": "resizeWindow", "width": 1000, "height": 700 },
    { "command": "selectReference", "referenceId": "factory:sax-growl" },
    { "command": "assertState", "path": "comparison.comparisonMidiNote", "equals": 57 },
    { "command": "assertState", "path": "performance.previewNote", "equals": 73 },
    { "command": "pinComparisonSpy", "probeId": "default-output" },
    {
      "command": "openNodeEditor",
      "nodeId": "timeLayer1",
      "waitForIdle": true,
      "idleDelayMs": 350
    },
    { "command": "assertState", "path": "comparison.visible", "equals": true },
    { "command": "assertState", "path": "comparison.cardCount", "op": "greaterThan", "value": 1 },
    { "command": "assertState", "path": "comparison.captureCount", "equals": 2 },
    {
      "command": "pointer",
      "event": "down",
      "targetId": "expanded:timeLayer1.trimeshMorphRail.red",
      "targetX": 0.2,
      "targetY": 0.5
    },
    {
      "command": "pointer",
      "event": "drag",
      "targetId": "expanded:timeLayer1.trimeshMorphRail.red",
      "downTargetId": "expanded:timeLayer1.trimeshMorphRail.red",
      "targetX": 0.65,
      "targetY": 0.5,
      "downTargetX": 0.2,
      "downTargetY": 0.5
    },
    { "command": "assertState", "path": "comparison.captureCount", "equals": 2 },
    {
      "command": "pointer",
      "event": "up",
      "targetId": "expanded:timeLayer1.trimeshMorphRail.red",
      "downTargetId": "expanded:timeLayer1.trimeshMorphRail.red",
      "targetX": 0.65,
      "targetY": 0.5,
      "downTargetX": 0.2,
      "downTargetY": 0.5,
      "waitForIdle": true,
      "idleDelayMs": 350
    },
    { "command": "assertState", "path": "comparison.captureCount", "equals": 3 },
    { "command": "assertState", "path": "comparison.cards.0.hasSurface", "equals": true },
    { "command": "assertState", "path": "comparison.cards.1.hasSurface", "equals": true },
    {
      "command": "assertState",
      "path": "comparison.cards.0.surfaceView.height",
      "op": "greaterThan",
      "value": 220
    },
    {
      "command": "assertState",
      "path": "comparison.cards.0.surfaceView.contextCreateCount",
      "op": "greaterThan",
      "value": 0
    },
    { "command": "inspectPointerTargets" }
  ],
  "quit": true
}
