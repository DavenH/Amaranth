    },
    {
      "command": "pointer",
      "event": "click",
      "targetId": "input:timeLayer1.modulationBundle",
      "targetX": 0.25,
      "waitForIdle": true,
      "idleDelayMs": 200
    },
    { "command": "assertState", "path": "nodeCount", "equals": 23 },
    { "command": "assertState", "path": "edgeCount", "equals": 23 },
    { "command": "assertState", "path": "compileSucceeded", "equals": true },
    {
      "command": "screenshot",
      "area": "canvas",
      "path": "/private/tmp/cycle-v2-trimesh-modulation-created.png"
    },
    { "command": "undo", "waitForIdle": true, "idleDelayMs": 150 },
    { "command": "assertState", "path": "nodeCount", "equals": 22 },
