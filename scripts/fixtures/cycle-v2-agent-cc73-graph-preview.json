{
  "commands": [
    { "command": "openGraph", "path": "../../cycle-v2/content/presets/altosax-2.cyclegraph" },
    { "command": "assertNodeParameter", "nodeId": "volumeEnvelope1", "parameterId": "red", "equals": "0.5" },
    { "command": "pointer", "targetId": "PerformanceKeyboard.CC73", "event": "down", "targetY": 0.98 },
    { "command": "pointer", "targetId": "PerformanceKeyboard.CC73", "event": "drag", "targetY": 0.75 },
    { "command": "pointer", "targetId": "PerformanceKeyboard.CC73", "event": "drag", "targetY": 0.25 },
    { "command": "assertNodeParameter", "nodeId": "volumeEnvelope1", "parameterId": "red", "equals": "0.5" },
    { "command": "pointer", "targetId": "PerformanceKeyboard.CC73", "event": "up", "targetY": 0.25 },
    { "command": "assertState", "path": "performance.cc73Value", "op": "greaterThan", "value": 90 },
    { "command": "assertNodeParameter", "nodeId": "volumeEnvelope1", "parameterId": "red", "op": "greaterThan", "value": 0.7 },
    { "command": "waitForIdle", "idleDelayMs": 4000 },
    { "command": "assertState", "path": "previewStats.0.nodeId", "equals": "volumeEnvelope1" },
    { "command": "assertState", "path": "previewStats.0.absoluteSum", "op": "greaterThan", "value": 108000 },
    { "command": "screenshot", "area": "canvas", "path": "/private/tmp/cycle-v2-cc73-graph-preview.png" },
    { "command": "undo" },
    { "command": "assertNodeParameter", "nodeId": "volumeEnvelope1", "parameterId": "red", "equals": "0.5" }
  ],
  "quit": true
}
