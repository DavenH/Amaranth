{
  "commands": [
    {
      "command": "openFactoryPreset",
      "preset": "saw",
      "waitForIdle": true,
      "idleDelayMs": 300
    },
    {
      "command": "captureAudio",
      "path": "/private/tmp/cycle-agent-inactive-volume.wav",
      "durationMs": 500,
      "sampleRate": 44100,
      "blockSize": 512,
      "channels": 2,
      "events": [
        {
          "type": "noteOn",
          "timeMs": 0,
          "note": 60,
          "velocity": 0.8,
          "channel": 1
        }
      ],
      "peakGreaterThan": 0.01,
      "final50MsRmsGreaterThan": 0.001,
      "peakLessThan": 1.5
    }
  ],
  "quit": true
}
