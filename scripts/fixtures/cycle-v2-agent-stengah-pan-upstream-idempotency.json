    {
      "command": "assertState",
      "path": "previewStats.4.audioProcessCount",
      "equals": 1
    },
    {
      "command": "setNodeParameter",
      "nodeId": "magnitudeLayer1Process",
      "parameterId": "pan",
      "label": "Pan",
      "value": "0.5"
    },
    {
      "command": "assertState",
      "path": "previewStats.4.audioProcessCount",
      "equals": 1
