{
  "commands": [
    {
      "command": "openGraph",
      "path": "../../cycle-v2/content/presets/old/stengah.cyclegraph"
    },
    {
      "command": "assertState",
      "path": "compileSucceeded",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "probePreviewStats.0.connected",
      "equals": true
    },
    {
      "command": "waitForIdle",
      "idleDelayMs": 250
    },
    {
      "command": "screenshot",
      "area": "canvas",
      "path": "/private/tmp/cycle-v2-spy-compact.png"
    },
    {
      "command": "pointer",
      "event": "doubleClick",
      "targetId": "spy:probe2",
      "waitForIdle": true,
      "idleDelayMs": 300
    },
    {
      "command": "assertState",
      "path": "probeDetailOpen",
      "equals": true
    },
    {
      "command": "assertState",
      "path": "probeDetailId",
      "equals": "probe2"
    },
    {
      "command": "assertState",
      "path": "probeDetailResolution",
      "equals": 512
    },
    {
      "command": "assertState",
      "path": "probeDetailColumns",
      "equals": 512
    },
    {
      "command": "assertState",
      "path": "probeDetailRows",
      "equals": 512
    },
    {
      "command": "inspectPointerTargets"
    },
    {
      "command": "screenshot",
      "area": "canvas",
      "path": "/private/tmp/cycle-v2-spy-detail.png"
    }
  ],
  "quit": true
}
