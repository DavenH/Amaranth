    "presetPresentation": {
        "version": 1,
        "description": "Compact pulse/spectrum/body saxophone study. CC2 breath and spectral brightness; CC1 tongue/breath attack; CC3 alternating closure. Two narrow pulses, multiplicative spectral color and one shared body response across notes. Play the embedded register/pressure phrase. Development prototype: register realism, vibrato and fluid connected articulation remain to be refined.",
        "tags": [ "Brass" ],
