            "id": "mod2",
            "kind": "modulationSource",
            "definitionVersion": 1,
            "position": { "x": 570.0, "y": 352.0 },
            "rationale": "Key-following reed edge: move one shared shape across the register, without fitting separate note spectra.",
            "parameters": { "source": "keyScale", "controller": 1, "constant": 0.5 }
        },
        {
            "id": "mesh",
            "kind": "trilinearMesh",
            "definitionVersion": 1,
            "position": { "x": 340.0, "y": 600.0 },
            "rationale": "Two narrow normalized reed pulses per oscillator cycle. Voice octave -1 restores nominal pitch. The even bins of this lower oscillator are the played note's full integer harmonic series. Sparse Guide rails delay and weaken the second closure at onset, settling in 120 ms. CC3 retains alternating closure. Grain is factory component-guide noise on the closing edges. Waveform stays visibly normalized; gain controls listening level.",
            "portSides": {
                "inputs": { "context": "top" }
            },
            "parameters": {
                "enabled": true,
                "gain": 0.824318349361,
                "range": 0.5,
                "signalType": "time",
                "phaseMode": "absolute",
                "polarity": "bipolar",
                "yellow": 0.0,
                "red": 0.261682,
                "blue": 0.0,
                "primaryAxis": "yellow",
                "link.yellow": true,
                "link.red": true,
                "link.blue": true
            },
            "model": {
