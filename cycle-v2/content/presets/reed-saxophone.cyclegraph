        {
            "id": "mesh",
            "kind": "trilinearMesh",
            "definitionVersion": 1,
            "position": { "x": 340.0, "y": 300.0 },
            "rationale": "Five-point reed kick repeated twice in each oscillator cycle. Voice octave -1 restores nominal pitch. The even bins of this lower oscillator are the played note's full integer harmonic series. CC2 narrows the closure; onset briefly perturbs the second copy, then settles in 120 ms. CC3 retains alternating closure. Grain is factory component-guide noise on the closing edges. Waveform stays visibly normalized; gain controls listening level.",
            "portSides": {
                "inputs": { "context": "top" }
            },
            "parameters": {
                "enabled": true,
                "gain": 0.5,
                "range": 0.5,
                "signalType": "time",
                "phaseMode": "absolute",
                "polarity": "bipolar",
                "yellow": 0.0,
                "red": 0.261682,
                "blue": 0.0,
                "primaryAxis": "yellow",
                "link.yellow": true,
                "link.red": true,
                "link.blue": true
            },
